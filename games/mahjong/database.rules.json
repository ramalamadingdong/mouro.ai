{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null && (!data.exists() || data.child('meta/host').val() === auth.uid || data.child('seats').hasChild(auth.uid) || data.child('meta/status').val() === 'waiting')",
        ".write": "auth != null && (($code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && !data.exists() && newData.child('meta/host').val() === auth.uid && newData.child('meta').hasChildren(['host', 'status', 'createdAt', 'updatedAt']) && !newData.hasChild('state') && !newData.hasChild('presence')) || (!newData.exists() && (data.child('meta/host').val() === auth.uid || (data.child('meta/createdAt').isNumber() && data.child('meta/updatedAt').isNumber() && now - data.child('meta/createdAt').val() > 86400000 && now - data.child('meta/updatedAt').val() > 86400000))))",
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{5}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['host', 'status', 'createdAt', 'updatedAt'])",
          "host": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())",
            "$deep": {
              ".validate": false
            }
          },
          "status": {
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && root.child('rooms').child($code).child('meta/host').val() === auth.uid && newData.isString() && data.exists() && data.val() === 'waiting' && newData.val() === 'playing'",
            ".validate": "newData.isString() && (data.exists() ? (data.val() === 'waiting' && newData.val() === 'playing') : newData.val() === 'waiting')",
            "$deep": {
              ".validate": false
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : (newData.val() <= now + 86400000 && newData.val() > now - 86400000))",
            "$deep": {
              ".validate": false
            }
          },
          "updatedAt": {
            ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && newData.isNumber() && newData.val() <= now + 3600000 && newData.val() > now - 3600000 && root.child('rooms').child($code).child('meta').exists() && (root.child('rooms').child($code).child('meta/status').val() === 'waiting' || root.child('rooms').child($code).child('seats').hasChild(auth.uid) || root.child('rooms').child($code).child('meta/host').val() === auth.uid)",
            ".validate": "newData.isNumber() && newData.val() <= now + 86400000 && (data.exists() ? newData.val() > now - 3600000 : newData.val() > now - 86400000)",
            "$deep": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "seats": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && (!newData.exists() || (root.child('rooms').child($code).child('meta').exists() && root.child('rooms').child($code).child('meta/status').val() === 'waiting' && newData.isString() && newData.val().length >= 3 && newData.val().length <= 120 && newData.val().matches(/^[0-9]{1,15}[|]/)))",
            ".validate": "$uid === auth.uid && $uid.length <= 128 && newData.isString() && newData.val().length >= 3 && newData.val().length <= 120 && newData.val().matches(/^[0-9]{1,15}[|]/)",
            "$deep": {
              ".validate": false
            }
          }
        },
        "state": {
          ".write": "auth != null && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && newData.hasChildren(['version', 'config', 'players', 'wall', 'phase', 'turnUid', 'drawn', 'via', 'dealer', 'wind', 'handNo', 'gameNo', 'lastMove']) && newData.child('version').isNumber() && newData.child('version').val() >= 1 && newData.child('version').val() <= 1000000 && ((newData.child('turnUid').val() === '*' && !newData.hasChild('toAct')) || (newData.child('toAct').val() === 0 && newData.child('turnUid').val() === newData.child('players/0/uid').val()) || (newData.child('toAct').val() === 1 && newData.child('turnUid').val() === newData.child('players/1/uid').val()) || (newData.child('toAct').val() === 2 && newData.child('turnUid').val() === newData.child('players/2/uid').val()) || (newData.child('toAct').val() === 3 && newData.child('turnUid').val() === newData.child('players/3/uid').val())) && (root.child('rooms').child($code).child('seats').hasChild(auth.uid) || root.child('rooms').child($code).child('meta/host').val() === auth.uid) && (!data.exists() ? (root.child('rooms').child($code).child('meta/host').val() === auth.uid && newData.child('lastMove/kind').val() === 'start') : ((data.child('players/0/uid').val() === auth.uid || data.child('players/1/uid').val() === auth.uid || data.child('players/2/uid').val() === auth.uid || data.child('players/3/uid').val() === auth.uid) && ((data.child('turnUid').val() === auth.uid && (newData.child('lastMove/kind').val() === 'discard' || newData.child('lastMove/kind').val() === 'kong' || newData.child('lastMove/kind').val() === 'win')) || (data.child('turnUid').val() === '*' && (newData.child('lastMove/kind').val() === 'claim' || newData.child('lastMove/kind').val() === 'away' || newData.child('lastMove/kind').val() === 'next' || newData.child('lastMove/kind').val() === 'rematch')) || (newData.child('lastMove/kind').val() === 'away' && data.hasChild('toAct') && data.child('turnUid').val() !== auth.uid && !root.child('rooms').child($code).child('presence').hasChild(data.child('turnUid').val()))))) && newData.child('lastMove/by').val() === auth.uid && (!data.exists() || newData.child('version').val() > data.child('version').val())",
          ".validate": "newData.hasChildren(['version', 'config', 'players', 'wall', 'phase', 'turnUid', 'drawn', 'via', 'dealer', 'wind', 'handNo', 'gameNo', 'lastMove'])",
          "version": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000",
            "$deep": {
              ".validate": false
            }
          },
          "turnUid": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128",
            "$deep": {
              ".validate": false
            }
          },
          "phase": {
            ".validate": "newData.isString() && (newData.val() === 'turn' || newData.val() === 'claim' || newData.val() === 'scored' || newData.val() === 'gameover')",
            "$deep": {
              ".validate": false
            }
          },
          "toAct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3",
            "$deep": {
              ".validate": false
            }
          },
          "wall": {
            ".validate": "newData.isString() && newData.val().length <= 144 && newData.val().matches(/^[a-zA-P]*$/)",
            "$deep": {
              ".validate": false
            }
          },
          "drawn": {
            ".validate": "newData.isString() && newData.val().length <= 1 && newData.val().matches(/^[a-zA-P]*$/)",
            "$deep": {
              ".validate": false
            }
          },
          "via": {
            ".validate": "newData.isString() && (newData.val() === 'draw' || newData.val() === 'kong' || newData.val() === 'claim')",
            "$deep": {
              ".validate": false
            }
          },
          "dealer": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3",
            "$deep": {
              ".validate": false
            }
          },
          "wind": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3",
            "$deep": {
              ".validate": false
            }
          },
          "handNo": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000",
            "$deep": {
              ".validate": false
            }
          },
          "gameNo": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000",
            "$deep": {
              ".validate": false
            }
          },
          "config": {
            ".validate": "newData.hasChildren(['minFaan', 'rounds'])",
            "minFaan": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10",
              "$deep": {
                ".validate": false
              }
            },
            "rounds": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4",
              "$deep": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "players": {
            ".validate": "newData.hasChildren(['0', '1', '2', '3'])",
            "$seat": {
              ".validate": "$seat.matches(/^[0-3]$/) && newData.hasChildren(['uid', 'name', 'isHuman', 'sitOut', 'score'])",
              "uid": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128",
                "$deep": {
                  ".validate": false
                }
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120",
                "$deep": {
                  ".validate": false
                }
              },
              "isHuman": {
                ".validate": "newData.isBoolean()",
                "$deep": {
                  ".validate": false
                }
              },
              "sitOut": {
                ".validate": "newData.isBoolean()",
                "$deep": {
                  ".validate": false
                }
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= -10000000 && newData.val() <= 10000000",
                "$deep": {
                  ".validate": false
                }
              },
              "hand": {
                ".validate": "newData.isString() && newData.val().length <= 14 && newData.val().matches(/^[a-zA-P]*$/)",
                "$deep": {
                  ".validate": false
                }
              },
              "melds": {
                ".validate": "newData.isString() && newData.val().length <= 24 && newData.val().matches(/^[a-zA-P,]*$/)",
                "$deep": {
                  ".validate": false
                }
              },
              "flowers": {
                ".validate": "newData.isString() && newData.val().length <= 8 && newData.val().matches(/^[a-zA-P]*$/)",
                "$deep": {
                  ".validate": false
                }
              },
              "discards": {
                ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-zA-P]*$/)",
                "$deep": {
                  ".validate": false
                }
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "claim": {
            ".validate": "newData.hasChildren(['tile', 'from', 'rob', 'asks'])",
            "tile": {
              ".validate": "newData.isString() && newData.val().length <= 1 && newData.val().matches(/^[a-zA-P]$/)",
              "$deep": {
                ".validate": false
              }
            },
            "from": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3",
              "$deep": {
                ".validate": false
              }
            },
            "rob": {
              ".validate": "newData.isBoolean()",
              "$deep": {
                ".validate": false
              }
            },
            "asks": {
              ".validate": "newData.isString() && newData.val().length <= 4 && newData.val().matches(/^[.?xwkplmh]{4}$/)",
              "$deep": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "result": {
            ".validate": "newData.hasChildren(['winner', 'from', 'faan', 'pay'])",
            "winner": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 3",
              "$deep": {
                ".validate": false
              }
            },
            "from": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 3",
              "$deep": {
                ".validate": false
              }
            },
            "faan": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100",
              "$deep": {
                ".validate": false
              }
            },
            "lines": {
              ".validate": "newData.isString() && newData.val().length <= 400 && newData.val().matches(/^[A-Za-z0-9 :|'-]*$/)",
              "$deep": {
                ".validate": false
              }
            },
            "pay": {
              ".validate": "newData.isString() && newData.val().length <= 60 && newData.val().matches(/^-?[0-9]+(,-?[0-9]+){3}$/)",
              "$deep": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "lastMove": {
            ".validate": "newData.hasChildren(['by', 'kind', 'seat'])",
            "by": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128",
              "$deep": {
                ".validate": false
              }
            },
            "kind": {
              ".validate": "newData.isString() && (newData.val() === 'start' || newData.val() === 'discard' || newData.val() === 'kong' || newData.val() === 'win' || newData.val() === 'claim' || newData.val() === 'away' || newData.val() === 'next' || newData.val() === 'rematch')",
              "$deep": {
                ".validate": false
              }
            },
            "seat": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3",
              "$deep": {
                ".validate": false
              }
            },
            "event": {
              ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'discard' || newData.val() === 'pung' || newData.val() === 'chow' || newData.val() === 'kong' || newData.val() === 'win' || newData.val() === 'draw' || newData.val() === 'pass')",
              "$deep": {
                ".validate": false
              }
            },
            "eventSeat": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3",
              "$deep": {
                ".validate": false
              }
            },
            "tile": {
              ".validate": "newData.isString() && newData.val().length <= 1 && newData.val().matches(/^[a-zA-P]*$/)",
              "$deep": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $code.matches(/^[A-HJKMNP-Z2-9]{5}$/) && (!newData.exists() || (root.child('rooms').child($code).child('meta').exists() && (root.child('rooms').child($code).child('seats').hasChild($uid) || root.child('rooms').child($code).child('meta/host').val() === $uid) && newData.isNumber() && newData.val() > 0))",
            ".validate": "$uid === auth.uid && $uid.length <= 128 && newData.isNumber() && newData.val() > 0",
            "$deep": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
