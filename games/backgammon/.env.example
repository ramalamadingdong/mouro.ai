# Firebase web config for online play.
#
# Copy this file to `.env` and paste the values from YOUR Firebase project
# (Project settings → General → Your apps → Web app → SDK setup and config).
# `.env` is git-ignored.
#
# These are NOT secrets. A Firebase web config is a set of public identifiers
# that ships inside every client anyway; security comes from the Realtime
# Database rules, not from hiding these.
#
# This app shares the `gin-rummey` Firebase project with the gin rummy app —
# the same eight values, different top-level nodes (bgRooms/, bgMatches/).
#
# Expo only inlines EXPO_PUBLIC_* at build time, so restart with a cleared
# cache after editing: npx expo start -c

EXPO_PUBLIC_FIREBASE_API_KEY=PASTE_ME
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=PASTE_ME
EXPO_PUBLIC_FIREBASE_DATABASE_URL=PASTE_ME
EXPO_PUBLIC_FIREBASE_PROJECT_ID=PASTE_ME
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=PASTE_ME
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_ME
EXPO_PUBLIC_FIREBASE_APP_ID=PASTE_ME
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=PASTE_ME
