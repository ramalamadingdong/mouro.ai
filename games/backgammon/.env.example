# Online play needs no configuration on the web: the page talks to the
# realtime server on its own host at /rt.
#
# Native builds (Expo Go / EAS) have no page host, so point them at a server:
EXPO_PUBLIC_REALTIME_URL=wss://mouro.ai/rt
#
# For local development run `npm start` in ../../server and use:
# EXPO_PUBLIC_REALTIME_URL=ws://<your-LAN-ip>:8787/rt
