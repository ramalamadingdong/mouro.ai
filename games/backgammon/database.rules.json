{
  "rules": {
    ".read": false,
    ".write": false,
    "bgRooms": {
      "$code": {
        ".read": "auth != null && (!data.exists() || data.child('meta/host').val() === auth.uid || data.child('meta/guest').val() === auth.uid || data.child('meta/status').val() === 'waiting')",
        ".write": "auth != null && ((!data.exists() && newData.child('meta/host').val() === auth.uid) || (!newData.exists() && (data.child('meta/host').val() === auth.uid || data.child('meta/guest').val() === auth.uid || (data.child('meta/createdAt').exists() && now - data.child('meta/createdAt').val() > 86400000 && data.child('meta/updatedAt').exists() && now - data.child('meta/updatedAt').val() > 86400000))))",
        ".validate": "$code.matches(/^[A-HJKMNP-Z2-9]{5}$/)",
        "meta": {
          ".write": "auth != null && (data.child('host').val() === auth.uid || data.child('guest').val() === auth.uid || (data.child('status').val() === 'waiting' && !data.child('guest').exists() && newData.child('guest').val() === auth.uid))",
          ".validate": "!data.exists() || newData.child('host').val() === data.child('host').val()",
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'finished')"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 25"
          }
        },
        "state": {
          ".write": "auth != null && (data.parent().child('meta/host').val() === auth.uid || data.parent().child('meta/guest').val() === auth.uid) && (!data.exists() ? data.parent().child('meta/host').val() === auth.uid : (data.child('turnUid').val() === auth.uid || data.child('phase').val() === 'gameOver' || data.child('phase').val() === 'matchOver')) && newData.child('lastMove/by').val() === auth.uid && (!data.exists() || newData.child('version').val() > data.child('version').val())",
          "turnUid": {
            ".validate": "newData.isString()"
          },
          "version": {
            ".validate": "newData.isNumber()"
          },
          "phase": {
            ".validate": "newData.isString()"
          },
          "target": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 25"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "$uid === data.parent().parent().child('meta/host').val() || $uid === data.parent().parent().child('meta/guest').val()"
          }
        },
        "rematch": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "$uid === data.parent().parent().child('meta/host').val() || $uid === data.parent().parent().child('meta/guest').val()"
          }
        },
        "draft": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "$uid === data.parent().parent().child('meta/host').val() || $uid === data.parent().parent().child('meta/guest').val()",
            "v": {
              ".validate": "newData.isNumber()"
            },
            "s": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "emotes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "$uid === data.parent().parent().child('meta/host').val() || $uid === data.parent().parent().child('meta/guest').val()",
            "emoji": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "n": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "bgMatches": {
      "$mid": {
        ".read": false,
        ".validate": "$mid.matches(/^[A-HJKMNP-Z2-9]{5}-[0-9]{10,15}$/)",
        "players": {
          ".write": "auth != null && !data.exists() && (newData.child('p0').val() === auth.uid || newData.child('p1').val() === auth.uid)",
          ".validate": "newData.child('p0').isString() && newData.child('p1').isString()"
        },
        "initial": {
          ".write": "auth != null && !data.exists()"
        },
        "meta": {
          ".write": "auth != null && !data.child('createdAt').exists()"
        },
        "log": {
          "$v": {
            ".write": "auth != null && !data.exists() && (data.parent().parent().child('players/p0').val() === auth.uid || data.parent().parent().child('players/p1').val() === auth.uid)",
            ".validate": "$v.matches(/^[0-9]+$/) && newData.hasChild('seat') && newData.hasChild('move')"
          }
        }
      }
    }
  }
}
