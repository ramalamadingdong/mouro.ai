{
  "_comment_paths": "start_url, scope and every icon src are RELATIVE: a manifest's relative URLs resolve against the manifest's own URL (/cat-cafe/manifest.webmanifest), so they stay in step with Vite's `base` with no build-time substitution.",
  "_comment_no_sw": "Deliberately no service worker, like the other games: a site redeployed this often is more likely to strand a player on a stale cached bundle than to be opened offline.",
  "name": "Cat Café",
  "short_name": "Cat Café",
  "description": "Draft cat-shaped tiles onto your café floor. Play the computer cats, or share a room code and play friends online.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0f2e34",
  "background_color": "#0f2e34",
  "categories": ["games"],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "_comment": "Full-bleed background with everything inside the middle 80%, so the same files are maskable.", "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
