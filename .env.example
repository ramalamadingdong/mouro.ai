# Firebase web config for online play.
#
# Copy this file to `.env` and paste the values from YOUR Firebase project:
#   Firebase console -> Project settings -> General -> Your apps -> Web app
#   -> "SDK setup and configuration" -> Config.
#
# `.env` is git-ignored. These values are NOT secrets — a Firebase web config is
# a set of public identifiers that ship inside every client bundle anyway.
# Security is enforced by firebase/database.rules.json, not by hiding these.
# See the header comment in src/fb/config.ts.
#
# Vite only exposes vars prefixed VITE_, and it inlines them by literal text
# substitution at build time. Restart `npm run dev` after editing this file —
# the dev server reads it at startup, not per-request.
#
# Also required in the console, or sign-in fails with an actionable error:
#   Build -> Authentication -> Get started -> enable the Anonymous provider.
#   Build -> Realtime Database -> create a database.

# Web API key. Authenticates the sign-in call. REQUIRED — one of the two vars
# `isFirebaseConfigured` checks.
VITE_FIREBASE_API_KEY=PASTE_ME

# Auth handler domain, usually <project-id>.firebaseapp.com. Used by the auth
# SDK for redirect flows; anonymous sign-in does not redirect, so this is
# effectively cosmetic here.
VITE_FIREBASE_AUTH_DOMAIN=PASTE_ME

# Realtime Database URL — which database to open a socket to. REQUIRED — the
# other var `isFirebaseConfigured` checks. Note the host carries the region:
# us-central1 databases look like https://<project-id>-default-rtdb.firebaseio.com
# while other regions look like
# https://<project-id>-default-rtdb.<region>.firebasedatabase.app
# Copying the wrong one yields a client that connects to nothing.
VITE_FIREBASE_DATABASE_URL=PASTE_ME

# Project id. Not used for connectivity in this app; keep it accurate anyway so
# console errors point at the right project.
VITE_FIREBASE_PROJECT_ID=PASTE_ME

# Cloud Storage bucket. This app never uploads anything — present only because
# initializeApp takes the whole config object.
VITE_FIREBASE_STORAGE_BUCKET=PASTE_ME

# Cloud Messaging sender id. Unused: there are no push notifications.
VITE_FIREBASE_MESSAGING_SENDER_ID=PASTE_ME

# Web app id. Identifies this specific app within the project (analytics).
VITE_FIREBASE_APP_ID=PASTE_ME
