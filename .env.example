# Copy this file to `.env` and paste the values from YOUR Firebase project:
#   Firebase console → Project settings (gear) → Your apps → Web app → config.
#
# These are PUBLIC identifiers, not secrets — a Firebase web config ships inside
# every client. Security is enforced by the Realtime Database rules in
# firebase/database.rules.json, not by hiding these values.
#
# `databaseURL` is REQUIRED and only appears after you create the Realtime
# Database in the console. After editing `.env`, restart:  npx expo start -c
EXPO_PUBLIC_FIREBASE_API_KEY=PASTE_ME
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=PASTE_ME.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://PASTE_ME-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=PASTE_ME
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=PASTE_ME.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=PASTE_ME
EXPO_PUBLIC_FIREBASE_APP_ID=PASTE_ME
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=PASTE_ME
