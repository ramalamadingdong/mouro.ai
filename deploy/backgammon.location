# nginx: serve the backgammon PWA at https://mouro.ai/backgammon/
#
# Installed once by deploy/install-nginx.sh into the mouro.ai server block,
# AHEAD of the site's `location /` Django proxy so it wins the prefix match.
#
# `try_files` order matters:
#   $uri        real files (the JS bundle, icons, manifest.json)
#   $uri.html   Expo's static export writes /solo as solo.html, not solo/index.html
#   $uri/       directory indexes
#   /backgammon/index.html   SPA fallback for anything else
#
# Dynamic routes (/join/<CODE> etc.) do NOT work through this block — their
# prerendered files are literally named `[code].html`, and nothing here maps a
# real room code onto that name. That is what backgammon-dynamic.location is for.

location = /backgammon {
    return 301 /backgammon/;
}

location /backgammon/ {
    root /home/rami;
    try_files $uri $uri.html $uri/ /backgammon/index.html;
}
