# nginx: serve the PRERENDERED shell for dynamic routes.
#
# `output: "static"` prerenders `dist/join/[code].html`, `dist/lobby/[code].html`
# and `dist/game/[code].html` — with the literal square brackets in the
# filename, because that is what the route file is called. Nothing maps
# `/backgammon/join/4K8HJ` onto `join/[code].html`, so without this block the
# prefix location's try_files falls through to `/backgammon/index.html` — the
# prerendered HOME shell. The browser then hydrates Home's markup with the Join
# screen's React tree, React throws hydration error #418, discards the server
# markup and re-renders everything. It works, visibly badly.
#
# A regex location beats a prefix location in nginx regardless of which is
# longer, so this wins over `location /backgammon/` without editing that block.
#
# The pattern matches the SHAPE of a room code (see src/util/room-code.ts), so a
# malformed link still falls through to the SPA fallback and gets the
# "that invite link didn't contain a valid room code" screen rather than a 404.
#
# The regex MUST stay quoted: unquoted, nginx reads `{5}` as block delimiters
# and `[` as the start of a character class in its own parser, and the config
# fails to load.
#
# Ordering note: the gin rummy app installs an identical block for its own
# prefix. The two regexes are disjoint — one only matches paths under
# /gin-rummey/, the other only under /backgammon/ — so no string can match both
# and the order between them does not matter.

location ~ "^/backgammon/(join|lobby|game)/[A-HJKMNP-Z2-9]{5}/?$" {
    root /home/rami;
    try_files "/backgammon/$1/[code].html" /backgammon/index.html;
}
