{
  "_comment_scope": "The hub starts at /games/ but its scope is the whole origin. That is on purpose: the games live at /backgammon/, /gin-rummy/, /yahtzee/ and /holdem/, outside /games/, and with a narrower scope every tap on a game would bounce the installed hub into a browser overlay. Each game still has its own manifest and installs as its own app from its own page.",
  "_comment_no_sw": "No service worker, same as the games: the hub will not launch offline, and in exchange nobody is ever stranded on a stale cached page.",
  "id": "/games/",
  "name": "Mouro Games",
  "short_name": "Games",
  "description": "Texas Hold'em, backgammon, gin rummy, Yahtzee, Sudoku and Cat Café for family game night. No accounts, no ads.",
  "start_url": "/games/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#14211c",
  "background_color": "#0c1512",
  "categories": ["games"],
  "_comment_links": "Invite links (/yahtzee/join/ABCDE and friends) are inside this app's scope too, so someone who installed the hub rather than the individual game should also land in their installed app. 'handle_links: preferred' asks the browser to route in-scope links into the app, and 'navigate-existing' points the already-open window at the invite instead of opening a second one. Where a game is installed as well, its narrower scope wins. Chromium-only; iOS ignores both and always opens links in Safari.",
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
