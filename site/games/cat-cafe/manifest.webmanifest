{
  "_comment": "Relative URLs resolve against this file, so everything lands under /games/cat-cafe/. No service worker — see the hub manifest one folder up.",
  "id": "/games/cat-cafe/",
  "name": "Cat Café",
  "short_name": "Cat Café",
  "description": "A calm tile puzzle: draft cat-shaped tiles, fit them onto your café floor, and outscore a computer cat.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "_comment_launch": "Same as the multiplayer games: when the app is installed and a link to it is opened, reuse the window that is already open instead of starting a second copy. Chromium-only; iOS ignores it.",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "theme_color": "#12383f",
  "background_color": "#0b2429",
  "categories": ["games"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
